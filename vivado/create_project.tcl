# Creates the Vivado project (regenx_vivado/regenx_vivado.xpr). Run from anywhere:
#   vivado -mode batch -source vivado/create_project.tcl -tclargs [PART]
# The .xpr is generated by this script, it is not shipped.
#
# FPGA target: pass a part name, or set it below. The default is the Artix-7 on the Basys 3
# (xc7a35tcpg236-1) ONLY so that out-of-context synthesis and timing have something to target;
# pick your real board before adding pin constraints (see vivado/pins_template.xdc).
set root [file dirname [file dirname [file normalize [info script]]]]
set part [expr {[llength $argv] > 0 ? [lindex $argv 0] : "xc7a35tcpg236-1"}]
set proj regenx_vivado

create_project -force $proj $root/$proj -part $part

# ---- design sources: synthesizable RTL only (package first) ----
set rtl [list \
    $root/rtl/regenx_pkg.sv $root/rtl/regenx_ecc.sv $root/rtl/regenx_mem_array.sv \
    $root/rtl/regenx_bist_controller.sv $root/rtl/regenx_fault_manager.sv \
    $root/rtl/regenx_spare_allocator.sv $root/rtl/regenx_addr_remap.sv $root/rtl/regenx_mem_arbiter.sv \
    $root/rtl/regenx_recovery_check.sv $root/rtl/regenx_repair_engine.sv \
    $root/rtl/regenx_mem_controller.sv $root/rtl/regenx_scrubber.sv $root/rtl/regenx_status_regs.sv \
    $root/rtl/regenx_top.sv]
add_files -fileset sources_1 $rtl
set_property file_type SystemVerilog [get_files -of_objects [get_filesets sources_1]]
set_property top regenx_top [get_filesets sources_1]

# ---- constraints: clock only. Pin locations are added after a board is chosen ----
add_files -fileset constrs_1 $root/vivado/regenx_timing.xdc

# ---- simulation set 1: self-checking regression + SVA bind (fault model compiled in) ----
create_fileset -simset sim_regress
add_files -fileset sim_regress $rtl $root/tb/sva/regenx_sva.sv $root/tb/regenx_tb.sv
set_property file_type SystemVerilog [get_files -of_objects [get_filesets sim_regress]]
set_property top regenx_tb [get_filesets sim_regress]
set_property verilog_define {REGENX_SIM} [get_filesets sim_regress]
set_property -name {xsim.simulate.runtime} -value {all} -objects [get_filesets sim_regress]
set_property -name {xsim.simulate.xsim.more_options} -value {-testplusarg seed=1} -objects [get_filesets sim_regress]

# ---- simulation set 2: UVM environment (needs the UVM library that ships with Vivado) ----
create_fileset -simset sim_uvm
add_files -fileset sim_uvm $rtl $root/tb/uvm/regenx_if.sv $root/tb/uvm/regenx_uvm_pkg.sv $root/tb/uvm/regenx_uvm_top.sv
set_property file_type SystemVerilog [get_files -of_objects [get_filesets sim_uvm]]
set_property top regenx_uvm_top [get_filesets sim_uvm]
set_property verilog_define {REGENX_SIM} [get_filesets sim_uvm]
set_property -name {xsim.compile.xvlog.more_options}   -value {-L uvm} -objects [get_filesets sim_uvm]
set_property -name {xsim.elaborate.xelab.more_options} -value {-L uvm} -objects [get_filesets sim_uvm]
set_property -name {xsim.simulate.xsim.more_options}   -value {-testplusarg UVM_TESTNAME=regenx_random_test -testplusarg UVM_VERBOSITY=UVM_LOW} -objects [get_filesets sim_uvm]
set_property -name {xsim.simulate.runtime} -value {all} -objects [get_filesets sim_uvm]

current_fileset -simset [get_filesets sim_regress]
update_compile_order -fileset sources_1
puts "VIVADO_PROJECT_CREATED $root/$proj/$proj.xpr (part $part)"
